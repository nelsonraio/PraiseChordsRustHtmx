# Base de dados e autenticação
DATABASE_URL=postgres://user:password@localhost:5432/praisechords
JWT_SECRET=troque-por-um-segredo-seguro

# Email: valores locais para Mailpit. Para produção substitua pelo SMTP final.
# Oracle Cloud Email Delivery:
#   SMTP_HOST=smtp.email.<regiao>.oci.oraclecloud.com  (ex: smtp.email.eu-frankfurt-1.oci.oraclecloud.com)
#   SMTP_PORT=587 com SMTP_SECURE=starttls  (ou 465 com SMTP_SECURE=true)
#   SMTP_USER / SMTP_PASSWORD = credenciais SMTP geradas na consola OCI (User Settings > SMTP Credentials)
#   SMTP_FROM tem de ser um "Approved Sender" (ou domínio verificado) na OCI
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="PraiseChords <noreply@localhost>"
APP_BASE_URL=http://127.0.0.1:8080
PASSWORD_RESET_TTL_MINUTES=60
